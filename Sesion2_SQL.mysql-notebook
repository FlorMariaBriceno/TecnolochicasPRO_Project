    "caption": "DB Notebook",
    "content": "\\about\nSHOW DATABASES;\nUSE tienda;\nUSE metro;\nSHOW TABLES;\nSELECT * FROM tienda.Detalles_Pedido ORDER BY precio_unitario DESC;\nSELECT AVG(precio_unitario) AS precio_promedio FROM tienda.Detalles_Pedido;\nSELECT * from tienda.Detalles_Pedido WHERE precio_unitario > 1000;\n\nSELECT nombre_producto, precio\nFROM Productos\nORDER BY precio;\nSELECT * FROM Productos WHERE precio > 20000;\nSELECT * FROM Usuarios; WHERE >= 30;\nDESCRIBE Usuarios;\nSELECT * FROM Productos WHERE precio <= 100\nSELECT * FROM Productos WHERE precio <> 100 ORDER BY precio ASC;\nSELECT * FROM Usuarios WHERE edad >= 30 AND fecha_registro >= '2020-05-01'\nSELECT * from Usuarios where edad >=30 and MONTH(fecha_registro) = 5;\nSELECT * from Productos WHERE Precio > 100 OR Stock_disponible = 0\nSELECT * from Usuarios where edad BETWEEN 20 and 30\nSELECT * From Usuarios ORDER BY fecha_registro DESC\nSELECT *\nFROM Usuarios\nWHERE YEAR(fecha_registro) BETWEEN '2021' AND '2023';\nSELECT * FROM Usuarios WHERE year(fecha_registro) BETWEEN '2021' AND '2023' ORDER BY year(fecha_registro) ASC\nSELECT nombre_producto FROM Productos WHERE precio > 50 ORDER BY nombre_producto ASC\nSELECT nombre_producto from Productos\nSELECT nombre_producto, precio from Productos\nSELECT nombre_producto, precio, Stock_disponible from Productos\nSELECT COUNT(*) FROM Usuarios\nSELECT format(cantidad,2) as cantidad_vendida from Detalles_Pedido\nSELECT cast(cantidad as decimal(10,3)) from Detalles_Pedido\nSELECT cast(cantidad as CHAR) from Detalles_Pedido\n",
